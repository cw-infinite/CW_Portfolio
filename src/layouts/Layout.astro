---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Lee Chulwoo — Portfolio OS', description = 'Airy, modern portfolio built with Astro + React + Framer Motion' } = Astro.props;
import '../styles/global.css';
import Nav from '../components/Nav.tsx';
import { navLinks, externalLinks } from '../data/navigation';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav client:load navLinks={navLinks} externalLinks={externalLinks} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line mt-24">
      <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-10 flex flex-col md:flex-row justify-between gap-6 text-[13px] text-neutral-500">
        <div>© {new Date().getFullYear()} Lee Chulwoo — Built with Astro + React + Framer Motion</div>
        <div class="flex gap-4">
          <a href="/topics" class="hover:text-black transition">Index</a>
          <a href="/about" class="hover:text-black transition">About</a>
          <a href="https://astro.build" class="hover:text-black transition">Astro</a>
        </div>
      </div>
    </footer>
  </body>
</html>
