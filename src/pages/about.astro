---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Me">
  <div class="mx-auto max-w-[1280px] px-6 md:px-10 pt-28">
    <div class="grid md:grid-cols-[0.9fr_1.1fr] gap-12">
      <div>
        <h1 class="font-display text-[48px] md:text-[72px] leading-[0.9] tracking-tight">Designer, builder, systems thinker.</h1>
        <p class="mt-6 text-[18px] leading-[1.5] text-neutral-600">I care about airy interfaces that still feel dense with meaning. Currently exploring Astro islands, motion semantics, and portfolio as OS.</p>
      </div>
      <div class="rounded-[24px] border border-line bg-white p-8 shadow-soft grid-lines">
        <div class="space-y-8">
          <div><div class="text-[11px] uppercase tracking-widest text-neutral-400">Stack</div><div class="mt-2 text-[14px]">Astro 5, React 19, TypeScript, Tailwind, Framer Motion 12, Vercel</div></div>
          <div><div class="text-[11px] uppercase tracking-widest text-neutral-400">Principles</div><div class="mt-2 text-[14px] leading-[1.6]">Clean > clever. Air > ornament. One primary action per viewport. Motion explains, never decorates.</div></div>
          <div><div class="text-[11px] uppercase tracking-widest text-neutral-400">Contact</div><div class="mt-2 text-[14px]">hello@example.com · Merrifield, VA</div></div>
        </div>
      </div>
    </div>
  </div>
</Layout>
